{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MemoriaCap",
  "version": "0.6.0",
  "identifier": "com.memoriacap.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MemoriaCap",
        "width": 1360,
        "height": 860,
        "minWidth": 1100,
        "minHeight": 700,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "Anexos de memorias de cálculo listos para radicar",
    "copyright": "MIT. Idea y versión original: Alejandro Jara.",
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
